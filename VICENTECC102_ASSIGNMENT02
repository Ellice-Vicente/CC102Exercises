#include <iostream>
using namespace std;

void analyzeGrades(int *grades, int students, int subjects) {
    int highest = 0;

    cout << "\nGrade Matrix:\n";
    for(int i = 0; i < students; i++) {
        int sum = 0;

        for(int j = 0; j < subjects; j++) {
            int value = *(grades + i*subjects + j);
            cout << value << " ";
            sum += value;

            if(value > highest) {
                highest = value;
            }
        }

        float average = (float)sum / subjects;
        cout << " | Average: " << average;
        cout << endl;
    }

    cout << "\nHighest grade in the matrix: " << highest << endl;
}

int main() {
    int students, subj;

    cout << "Enter number of students: ";
    cin >> students;

    cout << "Enter number of subjects: ";
    cin >> subj;

    int grades[100][100];

    cout << "\nEnter the grades:\n";
    for(int i = 0; i < students; i++) {
        for(int j = 0; j < subj; j++) {
            cout << "Student " << i+1 << ", Subject " << j+1 << ": ";
            cin >> grades[i][j];
        }
    }

    analyzeGrades(&grades[0][0], students, subj);

    return 0;
}
